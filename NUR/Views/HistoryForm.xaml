<UserControl
    x:Class="NUR.Views.HistoryForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    Background="#1A1A1B"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <TextBlock
                x:Name="emptyText"
                Margin="10,10,0,20"
                FontFamily="Arial Black"
                FontSize="26"
                Foreground="#FFD700"
                Text="ИСТОРИЯ ПРОСМОТРОВ" />

            <TextBlock
                x:Name="emptyHistoryTxt"
                HorizontalAlignment="Center"
                FontSize="16"
                Foreground="Gray"
                Text="История пуста"
                Visibility="{Binding EmptyVisibility}" />

            <ItemsControl ItemsSource="{Binding History}">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Margin="0,0,0,15"
                            Padding="10"
                            Background="#222"
                            CornerRadius="12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <!--  Постер  -->
                                <Border
                                    Width="110"
                                    Height="160"
                                    ClipToBounds="True"
                                    CornerRadius="10">

                                    <Image Source="{Binding Poster}" Stretch="UniformToFill" />

                                </Border>

                                <!--  Информация  -->
                                <StackPanel Grid.Column="1" Margin="15,5,10,5">

                                    <!--  Название  -->
                                    <TextBlock
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />

                                    <!--  Страна • Возраст • Год  -->
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">

                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#B0B0B0"
                                            Text="{Binding Country}" />

                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#666"
                                            Text=" • " />

                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#FFD700"
                                            Text="{Binding AgeRating}" />

                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#666"
                                             />

                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#B0B0B0"
                                            Text="{Binding Year}" />
                                    </StackPanel>

                                    <!--  Описание  -->
                                    <TextBlock
                                        MaxHeight="55"
                                        Margin="0,12,0,0"
                                        FontSize="14"
                                        Foreground="#D0D0D0"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />

                                </StackPanel>

                                <!--  Кнопка  -->
                                <Button
                                    Grid.Column="2"
                                    Height="40"
                                    Margin="10"
                                    VerticalAlignment="Center"
                                    Background="#FFD700"
                                    Content="СМОТРЕТЬ СНОВА"
                                    Cursor="Hand"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    Click="WatchRightNowBtn_Click"
                                    Style="{StaticResource ButtonRoundStyle}"/>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </StackPanel>

    </ScrollViewer>

</UserControl>