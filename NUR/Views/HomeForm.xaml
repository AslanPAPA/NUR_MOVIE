<UserControl
    x:Class="NUR.Views.HomeForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    Background="#1A1A1B"
    mc:Ignorable="d">




    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <StackPanel Margin="0,0,0,20">
                <TextBlock
                    Margin="10,0,0,10"
                    FontFamily="Arial Black"
                    FontSize="25"
                    Foreground="#FFD700"
                    Text="НОВИНКИ 2026" />

                <Grid>
                    <ListBox
                        x:Name="CarouselList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding FreshMovies}"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Width="320"
                                    Height="180"
                                    Margin="0,0,15,10"
                                    ClipToBounds="True"
                                    CornerRadius="12">
                                    <Grid>
                                        <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0.5" Color="Transparent" />
                                                    <GradientStop Offset="1" Color="#CC000000" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button
                        Width="40"
                        Height="40"
                        Margin="5,5,0,5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#88000000"
                        BorderThickness="0"
                        Click="ScrollLeft_Click"
                        Content="❮"
                        Cursor="Hand"
                        FontSize="15"
                        Foreground="#FFD700">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button
                        Width="40"
                        Height="40"
                        Margin="0,5,5,5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#88000000"
                        BorderThickness="0"
                        Click="ScrollRight_Click"
                        Content="❯"
                        Cursor="Hand"
                        FontSize="15"
                        Foreground="#FFD700">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding MovieGenres}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,30">
                            <TextBlock
                                Margin="10,5"
                                FontFamily="Arial Black"
                                FontSize="18"
                                Foreground="#FFD700"
                                Text="{Binding GenreName}" />

                            <ItemsControl ItemsSource="{Binding Movies}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="130"
                                            Margin="10"
                                            Background="#222"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <Image
                                                    Height="190"
                                                    Source="{Binding Poster}"
                                                    Stretch="UniformToFill" />

                                                <StackPanel Margin="8">
                                                    <TextBlock
                                                        MaxHeight="32"
                                                        Cursor="Hand"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="White"
                                                        Text="{Binding Title}"
                                                        TextWrapping="Wrap"
                                                        MouseDown="SelectMovie_MouseDown"/>

                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="10"
                                                        Foreground="Gray"
                                                        Text="{Binding Year}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>