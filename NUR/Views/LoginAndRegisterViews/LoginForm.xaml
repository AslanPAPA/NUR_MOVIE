<UserControl
    x:Class="NUR.Views.LoginAndRegisterViews.LoginForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NUR.Views.LoginAndRegisterViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="350"
    d:DesignWidth="360"
    mc:Ignorable="d">
    <StackPanel >
        <TextBlock
            Margin="0,0,0,5"
            FontSize="13"
            Foreground="#AAAAAA"
            Text="Имя пользователя" />
        <TextBox
            x:Name="txtLoginUsername"
            Height="35"
            Padding="8,7,5,5"
            Background="#1F2020"
            BorderBrush="#333333"
            CaretBrush="White"
            FontSize="14"
            Foreground="White" />

        <TextBlock
            Margin="0,15,0,5"
            FontSize="13"
            Foreground="#AAAAAA"
            Text="Пароль" />
        <PasswordBox
            x:Name="txtLoginPassword"
            Height="35"
            Padding="8,7,5,5"
            Background="#1F2020"
            BorderBrush="#333333"
            CaretBrush="White"
            FontSize="14"
            Foreground="White" />

        <Button
            x:Name="btnLogin"
            Margin="0,35,0,0"
            Click="btnLogin_Click"
            Content="Войти"
            Style="{StaticResource AuthButtonStyle}" />

        <TextBlock
            x:Name="LoadingText"
            HorizontalAlignment="Center"
            FontSize="14"
            Margin="0,20,0,0"
            FontWeight="SemiBold"
            Foreground="#FFFFFF"
            Opacity="0.4"
            Style="{StaticResource loadingPools}"
            Text="Выполняется вход..."
            Visibility="Collapsed" />

    </StackPanel>
</UserControl>