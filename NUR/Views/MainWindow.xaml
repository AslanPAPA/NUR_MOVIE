<Window
    x:Class="NUR.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NUR.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Main"
    Width="1340"
    Height="800"
    Loaded="MainWindow_Loaded"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource GridBackground}" MouseDown="Grid_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*" />
            <RowDefinition Height="9.3*" />
        </Grid.RowDefinitions>




        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Margin="10"
                Orientation="Horizontal">
                <Label
                    Margin="10,0,20,0"
                    Content="NUR"
                    FontSize="20"
                    FontWeight="ExtraBold"
                    Foreground="#FDDD2D" />

                <Button
                    x:Name="BtnCatalog"
                    Width="110"
                    HorizontalAlignment="Left"
                    Click="BtnCatalog_Click"
                    Content="{DynamicResource CatalogBtn}"
                    FontSize="15"
                    FontWeight="DemiBold"
                    Style="{StaticResource ButtonRoundStyle}" />
                <Popup
                    x:Name="CatalogPopup"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=BtnCatalog}"
                    StaysOpen="False">

                    <Border
                        Padding="10"
                        Background="#222"
                        BorderBrush="#444"
                        BorderThickness="1">

                        <StackPanel Width="180">
                            <Button
                                x:Name="BtnAllCatalog"
                                Margin="0,0,0,5"
                                Click="AllCatalog_Click"
                                Content="✔ Все"
                                Style="{StaticResource CatalogMenuButtonStyle}" />

                            <Button
                                x:Name="BtnMoviesCatalog"
                                Margin="0,0,0,5"
                                Click="MoviesCatalog_Click"
                                Content="Фильмы"
                                Style="{StaticResource CatalogMenuButtonStyle}" />

                            <Button
                                x:Name="BtnCartoonsCatalog"
                                Margin="0,0,0,5"
                                Click="CartoonsCatalog_Click"
                                Content="Мультфильмы"
                                Style="{StaticResource CatalogMenuButtonStyle}" />
                        </StackPanel>

                    </Border>

                </Popup>
                <Border
                    Margin="20,0,20,0"
                    Background="#1F2020"
                    CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <Image
                            Width="20"
                            Height="20"
                            Margin="10,5"
                            Source="/Assets/images/search.png" />
                        <TextBox
                            x:Name="SearchBox"
                            Width="150"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="White"
                            FontSize="15"
                            Foreground="White"
                            TextChanged="SearchBox_TextChanged" />

                        <Button
                            x:Name="BtnFilter"
                            Width="40"
                            Height="35"
                            Margin="0,0,0,0"
                            Click="BtnFilter_Click"
                            Style="{StaticResource ButtonRoundStyle}">
                            <Image
                                Width="20"
                                Height="20"
                                Margin="0,2,0,0"
                                Source="/Assets/images/filters.png" />
                        </Button>
                        <Popup
                            x:Name="FilterPopup"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=BtnFilter}"
                            StaysOpen="False">

                            <Border
                                Padding="15"
                                Background="#222"
                                BorderBrush="#444"
                                BorderThickness="1">

                                <StackPanel Width="250">

                                    <TextBlock Foreground="White" Text="Жанр" />

                                    <ComboBox
                                        x:Name="GenreFilter"
                                        Height="25"
                                        Margin="0,0,0,10"
                                        Style="{DynamicResource ComboBox}" />

                                    <TextBlock Foreground="White" Text="Актёр" />

                                    <ComboBox
                                        x:Name="ActorFilter"
                                        Height="25"
                                        Margin="0,0,0,10"
                                        Style="{DynamicResource ComboBox}" />

                                    <TextBlock Foreground="White" Text="Год" />

                                    <ComboBox
                                        x:Name="YearFilter"
                                        Height="25"
                                        Margin="0,0,0,15"
                                        Style="{DynamicResource ComboBox}" />

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                                        <Button
                                            Margin="0,0,10,0"
                                            Click="ResetFilters_Click"
                                            Content="Сброс" />

                                        <Button Click="ApplyFilters_Click" Content="Применить" />
                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </Popup>

                    </StackPanel>
                </Border>



                <StackPanel
                    Width="Auto"
                    Margin="0,0,0,0"
                    Button.Click="MenuButton_Click"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BtnHome"
                        Width="110"
                        Content="{DynamicResource MainBtn}"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Foreground="White"
                        Style="{StaticResource ButtonRoundStyle}" />


                    <Button
                        x:Name="BtnSettings"
                        Width="110"
                        Content="{DynamicResource SettingsBtn}"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Foreground="White"
                        Style="{StaticResource ButtonRoundStyle}" />
                    <Button
                        x:Name="BtnProfile"
                        Width="110"
                        Content="{DynamicResource ProfileBtn}"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Foreground="White"
                        Style="{StaticResource ButtonRoundStyle}" />
                    <Button
                        x:Name="BtnFavorites"
                        Width="110"
                        Content="{DynamicResource FavoriteBtn}"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Foreground="White"
                        Style="{StaticResource ButtonRoundStyle}" />
                    <Button
                        x:Name="BtnHistory"
                        Width="110"
                        Content="{DynamicResource HistoryBtn}"
                        FontSize="15"
                        FontWeight="DemiBold"
                        Foreground="White"
                        Style="{StaticResource ButtonRoundStyle}" />
                    <Border
                        x:Name="OfflineBanner"
                        Width="100"
                        Height="20"
                        Margin="10,0,0,0"
                        Panel.ZIndex="999"
                        Background="#D32F2F"
                        CornerRadius="10"
                        Visibility="Visible">

                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="8"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="📡 ОФФЛАЙН РЕЖИМ"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button Content="➖" Style="{StaticResource MinimizeButtonRoundStyle}" />
                <Button
                    Click="Close_Click"
                    Content="✖"
                    Style="{StaticResource CloseButtonRoundStyle}" />
            </StackPanel>
        </Grid>



        <Grid Grid.Row="1">
            <local:HomeForm x:Name="homeForm" Visibility="Visible" />
            <local:VideoForm x:Name="videoForm" Visibility="Collapsed" />
            <local:SettingsForm x:Name="settingsForm" Visibility="Collapsed" />
            <local:UserProfile x:Name="userProfile" Visibility="Collapsed" />
            <local:MovieDetailForm x:Name="movieDetailForm" Visibility="Collapsed" />
            <local:FavoritesForm x:Name="favoritesForm" Visibility="Collapsed" />
            <local:SearchResultsForm x:Name="searchResultsForm" Visibility="Collapsed" />
            <local:HistoryForm x:Name="historyForm" Visibility="Collapsed" />
        </Grid>

    </Grid>
</Window>
