<Window x:Class="NUR.Views.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка фильма" Height="200" Width="400" 
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#1A1A1B">
    <Grid Background="#1A1A1B">
        <StackPanel x:Name="DownloadPanel" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="Идет скачивание..." Foreground="White" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="DownloadBar" Height="30" IsIndeterminate="True" Foreground="#FFD700" Background="#333"/>
        </StackPanel>

        <StackPanel x:Name="FinishPanel" VerticalAlignment="Center" Margin="20" Visibility="Collapsed">
            <TextBlock Text="Скачивание завершено!" Foreground="#FFD700" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="ОК" Width="100" Height="40" Background="#FFD700" Foreground="Black" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>