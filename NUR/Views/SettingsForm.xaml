<UserControl
    x:Class="NUR.Views.SettingsForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:NUR.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid Margin="40">
        <StackPanel
            Width="500"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">

            <TextBlock
                Margin="0,0,0,30"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#FDDD2D"
                Text="Настройки приложения" />

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#1F2020"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{DynamicResource VideoStep}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="12"
                            Foreground="Gray"
                            Text="{DynamicResource VideoStepDesc}" />
                    </StackPanel>

                    <ComboBox
                        x:Name="ComboSkipTime"
                        Grid.Column="1"
                        Width="100"
                        Height="35"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        SelectedIndex="1"
                        Style="{DynamicResource ComboBox}">
                        <ComboBoxItem Content="5 сек" />
                        <ComboBoxItem Content="10 сек" />
                        <ComboBoxItem Content="15 сек" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#1F2020"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{DynamicResource LangApp}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="12"
                            Foreground="Gray"
                            Text="{DynamicResource LangAppDesc}" />
                    </StackPanel>

                    <ComboBox
                        x:Name="ComboSkwsipTime"
                        Grid.Column="1"
                        Width="100"
                        Height="35"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        SelectedIndex="1"
                        Style="{DynamicResource ComboBox}">
                        <ComboBoxItem Content="Английский" />
                        <ComboBoxItem Content="Русский" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="20"
                Background="#1F2020"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="Скорость воспроизведения" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="12"
                            Foreground="Gray"
                            Text="Скорость просмотра фильма " />
                    </StackPanel>

                    <ComboBox
                        x:Name="videoSPeedBox"
                        Grid.Column="1"
                        Width="100"
                        Height="35"
                        FontSize="14"
                        SelectedIndex="2"
                        SelectionChanged="videoSPeedBox_SelectionChanged"
                        Style="{DynamicResource ComboBox}">
                        <ComboBoxItem Content="0.5x" />
                        <ComboBoxItem Content="0.75x" />
                        <ComboBoxItem Content="1x" />
                        <ComboBoxItem Content="1.25x" />
                        <ComboBoxItem Content="1.5x" />
                        <ComboBoxItem Content="2x" />
                        
                    </ComboBox>
                   
                </Grid>
            </Border>
            <Border
    Margin="0,0,0,20"
    Padding="20"
    Background="#1F2020"
    CornerRadius="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Очистка кэша" />

                        <TextBlock
                Margin="0,5,0,0"
                FontSize="12"
                Foreground="Gray"
                Text="Удалить все скачанные фильмы" />
                    </StackPanel>

                    <Button
            Grid.Column="1"
            Width="140"
            Height="40"
            Content="ОЧИСТИТЬ"
            Click="ClearCache_Click"
                Style="{StaticResource DangerButton}"/>
                </Grid>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>